# =============================================================================
# LocalFix — environment template
# Copy to `.env` and fill in real values:  cp .env.example .env
# Never commit your real .env file.
# =============================================================================

# --- Core Django -------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-0123456789abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Include your Vercel/custom domain here in production, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Database (leave unset locally to use SQLite) -----------------------------
# Vercel production: use a managed PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/localfix
# Render/MySQL-compatible providers can still use this format:
# Format: mysql://<user>:<password>@<host>:<port>/<dbname>
# MYSQL_URL=mysql://localfix:secret@mysql-xyz.a.render.com:3306/localfix
# If your provider requires TLS (Aiven, PlanetScale...), point this at their CA pem:
# MYSQL_SSL_CA=

# --- Email (real SMTP delivery) ----------------------------------------------
# See README.md -> "Setting up real email" for provider-by-provider steps.
# Leave EMAIL_HOST empty in local dev to fall back to the console backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# The "From" header. Use a verified sender address from your provider.
DEFAULT_FROM_EMAIL=LocalFix <no-reply@localhost>
# Absolute base URL used in links inside emails.
SITE_BASE_URL=http://127.0.0.1:8000
# Where contact-form submissions are delivered.
CONTACT_EMAIL=you@example.com

# --- AI assistant -------------------------------------------------------------
# Groq (https://console.groq.com/keys — free key). Required for the AI chat;
# without it the assistant falls back to a rule-based matcher (still books pros).
GROQ_API_KEY=
LOCALFIX_AI_MODEL=openai/gpt-oss-20b

# --- Storage / uploads ---------------------------------------------------------
# Vercel production: configure an S3-compatible bucket; local dev uses ./media.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_QUERYSTRING_AUTH=False
