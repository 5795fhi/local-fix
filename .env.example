# =============================================================================
# LocalFix — environment template
# Copy to `.env` and fill in real values:  cp .env.example .env
# Never commit your real .env file.
# =============================================================================

# --- Core Django -------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-0123456789abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Include your Vercel/custom domain here in production, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Database ---------------------------------------------------------------
# Local development uses SQLite while this is unset.
# Vercel/Neon production: paste the Neon pooled or direct connection string.
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/localfix?sslmode=require
# DATABASE_URL=postgresql://user:password@host:5432/localfix?sslmode=require

# --- Email (real SMTP delivery) ----------------------------------------------
# See README.md -> "Setting up real email" for provider-by-provider steps.
# Leave EMAIL_HOST empty in local dev to fall back to the console backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# The "From" header. Use a verified sender address from your provider.
DEFAULT_FROM_EMAIL=LocalFix <no-reply@localhost>
# Absolute base URL used in links inside emails.
SITE_BASE_URL=http://127.0.0.1:8000
# Where contact-form submissions are delivered.
CONTACT_EMAIL=you@example.com

# --- AI assistant -------------------------------------------------------------
# Groq (https://console.groq.com/keys — free key). Required for the AI chat;
# without it the assistant falls back to a rule-based matcher (still books pros).
GROQ_API_KEY=
LOCALFIX_AI_MODEL=openai/gpt-oss-20b
